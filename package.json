{
  "name": "gympro",
  "version": "1.0.0",
  "private": true,
  "description": "GymPro — نرم‌افزار مدیریت باشگاه بدنسازی (دسکتاپ، آفلاین، پرتابل)",
  "main": "apps/desktop/dist/main.cjs",
  "author": "GymPro",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:main && electron . --dev",
    "build:ui": "next build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:ui && npm run build:main",
    "smoke": "npm run build && electron . --smoke-test",
    "dist": "npm run build && electron-builder --win portable --dir=false",
    "typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.460.0",
    "next": "^15.1.9",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
